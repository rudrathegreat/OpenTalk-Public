{
  "name": "opentalk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npm run build && electron apps/desktop",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests tools --ignore-pattern tools/subscription-check",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:probe": "node tools/subscription-check/login-check.mjs --self-test",
    "smoke:meetings": "electron tools/meetings-smoke.cjs",
    "smoke:assistant": "electron tools/assistant-smoke.cjs",
    "smoke:overlay": "electron tools/overlay-visibility-smoke.cjs",
    "bench:worker": "node tools/worker-benchmark.mjs --ready",
    "perf:summary": "node tools/timing-summary.mjs",
    "test:worker-preparation": "node tools/worker-preparation-check.mjs",
    "test:worker-stream": "node tools/worker-stream-check.mjs",
    "test:cpu-pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-native.ps1 -Test -Fixture",
    "bench:cpu-200": "node tools/worker-stream-check.mjs --synthetic",
    "test:moonshine": "node tools/worker-stream-check.mjs --moonshine",
    "bench:moonshine-200": "node tools/worker-stream-check.mjs --moonshine --synthetic",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-native.ps1",
    "native:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-native.ps1 -Test",
    "package:win": "npm run check && npm run native:build && node tools/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
